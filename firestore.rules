rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isActiveUser() {
      return isSignedIn() && userDoc().isActive == true;
    }
    function hasRole(roles) {
      return isActiveUser() && userDoc().role in roles;
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || hasRole(['MASTER', 'ADMIN']));
      allow write: if hasRole(['MASTER']);
    }

    match /borrowers/{borrowerId} {
      allow read: if isActiveUser();
      allow create, update: if hasRole(['MASTER', 'ADMIN', 'AGENT']);
      allow delete: if hasRole(['MASTER']);
    }

    match /loan_products/{productId} {
      allow read: if isActiveUser();
      allow write: if hasRole(['MASTER']);
    }

    match /loans/{loanId} {
      allow read: if isActiveUser();
      allow create, update: if hasRole(['MASTER', 'ADMIN', 'AGENT']);
      allow delete: if hasRole(['MASTER']);
    }

    match /installment_schedule/{installmentId} {
      allow read: if isActiveUser();
      allow create, update: if hasRole(['MASTER', 'ADMIN', 'AGENT']);
      allow delete: if hasRole(['MASTER']);
    }

    match /transactions/{txnId} {
      allow read: if isActiveUser();
      allow create: if hasRole(['MASTER', 'ADMIN', 'AGENT']);
      allow update, delete: if false;
    }

    match /collection_logs/{logId} {
      allow read: if isActiveUser();
      allow create: if hasRole(['MASTER', 'ADMIN', 'AGENT']);
      allow update: if hasRole(['MASTER', 'ADMIN']);
      allow delete: if hasRole(['MASTER']);
    }
  }
}
