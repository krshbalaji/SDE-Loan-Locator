rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSarodeviAdmin() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        request.auth.token.email.matches('(?i).*sar[ao]devi.*');
    }

    function userDocExists() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function roleFromDoc() {
      return userDocExists()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : '';
    }

    function isActiveUser() {
      return isSarodeviAdmin() ||
        (userDocExists() &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_active != false);
    }

    function effectiveRole() {
      return isSarodeviAdmin()
        ? 'SUPER_ADMIN'
        : (request.auth.token.role != null && request.auth.token.role != ''
            ? request.auth.token.role
            : roleFromDoc());
    }

    function isSuperAdmin() {
      return isActiveUser() && effectiveRole() == 'SUPER_ADMIN';
    }

    function isExecutive() {
      return isActiveUser() && effectiveRole() in ['SUPER_ADMIN', 'CEO', 'MD', 'MASTER'];
    }

    function isAdminOrAbove() {
      return isActiveUser() && effectiveRole() in ['SUPER_ADMIN', 'CEO', 'MD', 'MASTER', 'AREA_MANAGER', 'BRANCH_MANAGER', 'COLLECTION_MANAGER', 'ADMIN'];
    }

    match /app_config/{docId} {
      allow read: if true;
      allow write: if isExecutive();
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdminOrAbove());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdminOrAbove());
      allow delete: if isSuperAdmin();
    }

    match /loan_products/{productId} {
      allow read: if isActiveUser();
      allow write: if isExecutive();
    }

    match /borrowers/{borrowerId} {
      allow read: if isActiveUser();
      allow create, update: if isActiveUser() &&
        (isAdminOrAbove() || resource == null || resource.data.assigned_agent_id == request.auth.uid);
      allow delete: if isExecutive();
    }

    match /loans/{loanId} {
      allow read: if isActiveUser();
      allow create, update: if isActiveUser() &&
        (isAdminOrAbove() || resource == null || resource.data.assigned_agent_id == request.auth.uid);
      allow delete: if isExecutive();
    }

    match /installment_schedule/{installmentId} {
      allow read: if isActiveUser();
      allow create, update: if isActiveUser();
      allow delete: if isExecutive();
    }

    match /transactions/{txnId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser();
      allow update, delete: if false;
    }

    match /collection_logs/{logId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser();
      allow update: if isAdminOrAbove();
      allow delete: if false;
    }
  }
}

